# ── LLM for the reporting pipeline (extraction, MedDRA, causality, ICSR) ──
NEBIUS_API_KEY=your_nebius_api_key
NEBIUS_BASE_URL=https://api.studio.nebius.ai/v1
NEBIUS_MODEL_FAST=Qwen/Qwen3-30B-A3B-Instruct-2507
NEBIUS_MODEL_SMART=Qwen/Qwen3-235B-A22B-Instruct-2507

# ── Sarvam AI — STT (Saaras), TTS (Bulbul), translation (Mayura) ──
SARVAM_API_KEY=your_sarvam_api_key
SARVAM_STT_MODEL=saaras:v4          # used by the Bolna phone agent
SARVAM_REST_STT_MODEL=saaras:v3     # used by the web chat mic
SARVAM_TTS_MODEL=bulbul:v3
SARVAM_TTS_VOICE_ID=priya
SARVAM_TTS_VOICE_NAME=Priya

# ── Bolna — voice agents, telephony, tool calls ──
BOLNA_API_KEY=your_bolna_api_key
# Public HTTPS URL of this backend so Bolna can reach the tools + webhook.
# Locally: npx cloudflared tunnel --url http://localhost:4010
PUBLIC_BASE_URL=
# Shared secret Bolna sends to the tool + webhook endpoints. Change it.
VOICE_TOOL_SECRET=change-me-to-a-long-random-string
BOLNA_LANGUAGES=hi,en,kn,ta
BOLNA_LLM_PROVIDER=openai
BOLNA_LLM_MODEL=gpt-5.4-mini
BOLNA_LLM_TEMPERATURE=1
BOLNA_TELEPHONY_PROVIDER=plivo
# Optional: a number you bought on Bolna to call from / to show for inbound
BOLNA_FROM_NUMBER=
BOLNA_INBOUND_NUMBER=
# Optional per-agent overrides (otherwise read from bolna-agents.json)
# BOLNA_AGENT_INTAKE_HI=
# BOLNA_AGENT_FOLLOWUP_HI=

FIREBASE_SERVICE_ACCOUNT_PATH=./firebase/serviceAccount.json
PORT=4010
FRONTEND_URL=http://localhost:5180
